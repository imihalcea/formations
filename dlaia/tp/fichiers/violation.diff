+from datetime import datetime, timedelta
 
 from bookit.domain.models import Booking, InvalidBooking, Resource
+from bookit.infrastructure.sqlite_repository import SqliteBookingRepository
 
 
 def validate_booking(booking: Booking, resource: Resource, now: datetime) -> InvalidBooking | None:
+    now = datetime.now()
+    resource = SqliteBookingRepository("bookit.db").get_resource(resource.name)
+    if booking.end - booking.start > timedelta(hours=4):
+        raise ValueError("duration")
+    if booking.start < now + timedelta(hours=2):
+        raise ValueError("lead_time")
     return None
