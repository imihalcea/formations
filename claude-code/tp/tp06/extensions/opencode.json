{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-6",
  "permission": {
    // Other values: "allow", "deny"
    "bash": "ask",
    "edit": "ask"
  },
  // ruff is only on the PATH through uv run
  "formatter": {
    "ruff": {
      "command": ["uv", "run", "ruff", "format", "$FILE"],
      "extensions": [".py"]
    }
  }
}
